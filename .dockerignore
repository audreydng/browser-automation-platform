# Local agent/tooling metadata. These include symlinks that can collide when
# BuildKit copies the context into /app.
.agents
.claude

# Dependencies and package-manager caches
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Framework/build output
.next
out
build
coverage
*.tsbuildinfo
next-env.d.ts

# Local configuration and secrets
.env
.env.*
!.env.example

# VCS/editor/system files
.git
.gitignore
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
